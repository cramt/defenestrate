pkgbase = dfnstrate-git
	pkgdesc = Builds a declarative Windows install from Microsoft's stock ISO, and flashes it
	pkgver = 0.1.0.r48.ge07f2a2
	pkgrel = 1
	url = https://github.com/cramt/defenestrate
	arch = x86_64
	license = MIT
	makedepends = git
	makedepends = rustup
	makedepends = mingw-w64-gcc
	makedepends = openssl
	makedepends = osslsigncode
	depends = libgcc
	depends = glibc
	depends = 7zip
	depends = wimlib
	depends = hivex
	depends = libisoburn
	depends = util-linux
	optdepends = chromium: dfnstrate fetch, and build without --iso (or google-chrome, or --browser)
	optdepends = qemu-desktop: dfnstrate vm and build image (qemu-base is enough for build image alone)
	optdepends = swtpm: dfnstrate vm and build image
	optdepends = edk2-ovmf: Secure Boot firmware for dfnstrate vm and build image
	optdepends = mtools: dfnstrate build image, and flash --into-free-space
	optdepends = sleuthkit: dfnstrate build image
	optdepends = ntfs-3g: dfnstrate flash and update
	optdepends = efibootmgr: dfnstrate flash and reboot
	optdepends = sudo: dfnstrate flash, update and reboot
	provides = dfnstrate
	conflicts = dfnstrate
	options = !lto
	source = dfnstrate::git+https://github.com/cramt/defenestrate.git
	sha256sums = SKIP

pkgname = dfnstrate-git
